# 应用配置
APP_NAME=File Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# 服务配置
HOST=0.0.0.0
PORT=9094

# user-service 对接（JWT 消费方）
# user-service 的基础 URL，用于拉取 JWKS 公钥（Docker 网络内用服务名，本地用 localhost）
USER_SERVICE_URL=http://localhost:8000
# JWKS 缓存 TTL（秒），到期后强制从 user-service 刷新；kid 未命中时也会立即刷新
JWKS_CACHE_TTL_SECONDS=3600
# JWT 签名算法（与 user-service 一致）
ALGORITHM=RS256

# 文件存储
# 本地存储根目录（LocalStorageProvider；未来可替换 COS/OSS/S3）
STORAGE_DIR=storage
# 允许的存储目录分类（白名单，上传/下载按此路由；第一个为默认目录）
STORAGE_CATEGORIES=["image"]
# 单文件大小上限（字节，默认 5MB）
MAX_FILE_SIZE=5242880
# 允许的 MIME 类型
ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]
# 允许的文件扩展名（小写）
ALLOWED_EXTENSIONS=[".jpg",".jpeg",".png",".webp"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/file_service.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# CORS 配置
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:9094"]
